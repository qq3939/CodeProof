# 复制为 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 里，永远不要提交真实密钥。

# ---------------- 基础 ----------------
ENV=dev                       # dev / test / prod；prod 下 Cookie 带 Secure，dev-login 强制关闭
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8090,http://localhost:5173   # 允许发写请求的来源（CSRF 校验）

# ---------------- 数据库与 Redis（本机开发用；Compose 里会被覆盖为服务名） ----------------
POSTGRES_USER=projectb
POSTGRES_PASSWORD=projectb
POSTGRES_DB=projectb
DATABASE_URL=postgresql+asyncpg://projectb:projectb@localhost:5433/projectb
REDIS_URL=redis://localhost:6380/0

# ---------------- 登录 ----------------
JWT_SECRET=please-change-me-to-a-long-random-string   # 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_EXPIRE_HOURS=168
# GitHub OAuth App：https://github.com/settings/developers → New OAuth App
#   Homepage URL: http://localhost:8090
#   Authorization callback URL: http://localhost:8090/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8090/api/auth/github/callback
FRONTEND_URL=http://localhost:8090
ADMIN_GITHUB_LOGINS=          # 逗号分隔的 GitHub 登录名，这些用户能看到运维页
ENABLE_DEV_LOGIN=true         # 没配 OAuth 时用开发登录（输入任意用户名）；生产环境无效

# ---------------- 模型 ----------------
# fake：不调用任何外部模型，输出确定，适合开发和测试；openai_compatible：任何兼容 OpenAI 接口的服务
LLM_PROVIDER=fake
LLM_BASE_URL=                 # 例如 https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_STRONG=fake-strong  # 出题、阅卷、核对代码用的强模型
LLM_MODEL_FAST=fake-fast      # 快速判断、提示用的快模型；强模型失败时也会降级到它
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
EMBEDDING_BASE_URL=           # 留空则沿用 LLM_BASE_URL
EMBEDDING_API_KEY=            # 留空则沿用 LLM_API_KEY
EMBEDDING_MODEL=fake-embedding
EMBEDDING_DIM=256             # 必须和嵌入模型的维度一致；改了要重建数据库（迁移按它建向量列）
# 计费表：每百万 token 的价格，用于成本统计
LLM_PRICE_TABLE={"fake-strong": {"input": 2.0, "output": 8.0}, "fake-fast": {"input": 0.5, "output": 1.0}}
DAILY_TOKEN_QUOTA=2000000     # 每个用户每天的 token 上限
SESSION_TOKEN_BUDGET=200000   # 单场考核的 token 预算，用完自动结束

# ---------------- 仓库与检索 ----------------
REPO_STORAGE_DIR=/data/repos
MAX_REPO_MB=200
MAX_FILES=20000
MAX_FILE_KB=512               # 超过的单个文件不建索引
CLONE_TIMEOUT_S=180
STORAGE_LIMIT_GB=10           # 超过后按最近最少使用清理旧快照的代码（数据库里的分析结果保留）
RETRIEVAL_MODE=agentic        # agentic / vector / hybrid
ALLOW_FILE_REPOS=false        # 仅测试用：允许 file:// 仓库地址

# ---------------- 考核 ----------------
QUEUE_MODE=arq                # arq：后台 worker；inline：在 api 进程里跑（只用于测试）
MAX_FOLLOWUP_DEPTH=3
HINT_PENALTY=5,10,20          # 一、二、三级提示的扣分
PASS_SCORE=60
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_ACTIVE_SESSIONS_PER_USER=3
RATE_LIMIT_PER_MINUTE=120

# ---------------- GitHub App（私有仓库，可选，尚未启用） ----------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

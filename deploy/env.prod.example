# 生产环境配置模板。在服务器上：cp deploy/env.prod.example .env，然后把所有写着占位值的配置换掉。
# .env 不进 git，也不要发给任何人（包括聊天里）。
# 每个变量的详细含义见项目根目录的 .env.example。

# 让 `docker compose` 自动叠加生产覆盖文件
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---------------- 基础 ----------------
DOMAIN=exam.fufu235.top
ENV=prod
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://exam.fufu235.top

# ---------------- 数据库 ----------------
POSTGRES_USER=projectb
# 生成：openssl rand -hex 24（只用字母数字，避免特殊字符破坏连接串）
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=projectb

# ---------------- 登录 ----------------
# 生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_HOURS=168
# GitHub OAuth App（https://github.com/settings/developers）：
#   Homepage URL:               https://exam.fufu235.top
#   Authorization callback URL: https://exam.fufu235.top/api/auth/github/callback
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
OAUTH_REDIRECT_URL=https://exam.fufu235.top/api/auth/github/callback
FRONTEND_URL=https://exam.fufu235.top
ADMIN_GITHUB_LOGINS=CHANGE_ME
ENABLE_DEV_LOGIN=false

# ---------------- 模型 ----------------
# 先用 fake 跑通部署；拿到模型 Key 后改成 openai_compatible 并填下面几项（见 docs/deploy.md 第 9 步）
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_STRONG=fake-strong
LLM_MODEL_FAST=fake-fast
# 嵌入模型用阿里云百炼 text-embedding-v4（D-018）；DeepSeek 没有嵌入接口，地址和 Key 必须单独填
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
# 必须和嵌入模型一致；上线后再改要重建数据库（会丢数据），所以最好一开始就定好
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIMENSIONS=true
# 阿里云单次最多 10 条
EMBEDDING_BATCH_SIZE=10
LLM_PRICE_TABLE={"fake-strong": {"input": 2.0, "output": 8.0}, "fake-fast": {"input": 0.5, "output": 1.0}}
DAILY_TOKEN_QUOTA=2000000
SESSION_TOKEN_BUDGET=200000

# ---------------- 仓库存储 ----------------
# 系统盘只有几十 GB，给克隆下来的仓库留 5 GB，超了自动清理最久没用的
STORAGE_LIMIT_GB=5
MAX_REPO_MB=200
